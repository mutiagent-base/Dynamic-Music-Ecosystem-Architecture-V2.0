{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "User profile data and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "song": {
      "title": "Saved Song Metadata",
      "description": "User created or generated song metadata and lyrics",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "concept": { "type": "string", "maxLength": 500 },
        "lyrics": { "type": "string", "maxLength": 5000 },
        "stylePrompt": { "type": "string", "maxLength": 200 },
        "bpm": { "type": "number" },
        "musicalKey": { "type": "string", "maxLength": 20 },
        "vocalDesc": { "type": "string", "maxLength": 300 },
        "instrumentsDesc": { "type": "string", "maxLength": 300 },
        "productionDesc": { "type": "string", "maxLength": 300 },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "stylePrompt", "userId"]
    },
    "preset": {
      "title": "Song Preset",
      "description": "Curated or user custom preset template",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "genre": { "type": "array" },
        "instrumentation": { "type": "array" },
        "vocalStyle": { "type": "array" },
        "productionPolish": { "type": "array" },
        "bpm": { "type": "number" },
        "musicalKey": { "type": "string", "maxLength": 20 },
        "sampleLyrics": { "type": "string", "maxLength": 3000 },
        "rating": { "type": "number" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "bpm", "musicalKey", "userId"]
    },
    "enrollment": {
      "title": "Public Class Enrollment",
      "description": "User enrollment in a public masterclass or workshop",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "classTitle": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "experienceLevel": { "type": "string" },
        "userId": { "type": "string" },
        "enrolledAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["classId", "classTitle", "studentName", "studentEmail", "userId"]
    },
    "ticket": {
      "title": "Customer Service Ticket",
      "description": "Real-time user support inquiry or priority concierge ticket",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "messages": { "type": "array" },
        "createdAt": { "type": "string" },
        "rating": { "type": "number" }
      },
      "required": ["userId", "subject", "category"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User profile document"
    },
    "/songs/{songId}": {
      "schema": "song",
      "description": "Collection of saved song blueprints"
    },
    "/presets/{presetId}": {
      "schema": "preset",
      "description": "Collection of custom and shared presets"
    },
    "/enrollments/{enrollmentId}": {
      "schema": "enrollment",
      "description": "Collection of public class enrollments"
    },
    "/tickets/{ticketId}": {
      "schema": "ticket",
      "description": "Collection of customer support tickets"
    }
  }
}
